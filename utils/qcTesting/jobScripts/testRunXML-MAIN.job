#! /bin/bash
#$ -N QC-dev--main
#$ -S /bin/bash
#$ -q bigmem-r8.q,research-r8.q,researchlong-r8.q,researchshort-r8.q #Operational eventually?
#$ -pe shmem-1 1
#$ -l h_rss=20G,mem_free=20G,h_data=20G
#$ -l h_rt=4:00:00
#$ -v STORE,SNAPPY
#$ -M geche8548@met.no
#$ -m abe
#$ -P dsa
#$ -o /lustre/storeB/project/fou/kl/cerad/Projects/QC/Logs
#$ -e /lustre/storeB/project/fou/kl/cerad/Projects/QC/Logs

umask 0002

set -x

LOGFILE=/lustre/storeB/project/fou/kl/cerad/Projects/QC/Logs/xml-main_v${SNAPPY}_$(date -d "today" +"%Y%m%dT%H%M").log
LUSTRE=/lustre/storeB/project/fou/kl/cerad/Projects/QC/ModelRuns
SNAPQCDIR=/home/geche8548/snap/utils/qcTesting/input/xml-requests
VDIR=v$SNAPPY

cd $LUSTRE

if ! [ -d "/modules/rhel8/user-apps/fou-modules/SnapPy/$SNAPPY" ]; then
    echo "SnapPy module $SNAPPY does not exist." >> "$LOGFILE"
    exit 1
fi

if [ -d "$LUSTRE/v$SNAPPY" ]; then
    echo "Directory v$SNAPPY already exists. Deleting old model runs directory" >> "$LOGFILE"
    rm -r $LUSTRE/$VDIR
fi

if [ -d "$LUSTRE/../PublicResults/data/$VDIR" ]; then
    echo "Directory v$SNAPPY already exists. Deleting old public results directory" >> "$LOGFILE"
    rm -r $LUSTRE/$VDIR
fi

#     echo "Directory v$SNAPPY already exists. Delete old directory to run again or try different version." >> "$LOGFILE"
#     exit "Directory v$SNAPPY already exists."
# else
#     echo "Creating version directory" >> "$LOGFILE"
#     mkdir "v$SNAPPY"
#     VDIR=v$SNAPPY
# fi

mkdir $LUSTRE/$VDIR
mkdir $LUSTRE/../PublicResults/data/$VDIR
SNAPPY=$SNAPPY qsub /home/geche8548/snap/utils/qcTesting/jobScripts/testRunXML.job


