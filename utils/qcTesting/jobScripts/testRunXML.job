LOGFILE=/lustre/storeB/project/fou/kl/cerad/Projects/QC/Logs/${NAME}_v${SNAPPY}_$(date -d "today" +"%Y%m%dT%H%M").log

snap4rimsterm --rimsterm $RIMSTERM_XML --argosrequest $ARGOS_REQUEST $OPS --dir $DIR --ident $IDENT --metmodel $METMODEL >> "$LOGFILE" 2>&1


cd $DIR
mkdir $LUSTRE../PublicResults/data/$VDIR/$DIR
VENVDIR=/lustre/storeB/project/fou/kl/cerad/Projects/QC/ModelRuns/v2.5.30/
source $VENVDIR.venv/bin/activate

for v in ${VARS[@]}; do 
    mkdir $LUSTRE../PublicResults/data/$VDIR/$DIR/$v
    PYTHONPATH=$VENVDIR python3 /home/geche8548/snap/utils/SnapPy/snap2webp.py --nc snap.nc --var $v --output-dir $LUSTRE../PublicResults/data/$VDIR/$DIR/$v >> "$LOGFILE" 2>&1
done


